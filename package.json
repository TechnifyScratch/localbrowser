{
  "name": "local-browser",
  "version": "0.19.0",
  "private": true,
  "description": "A small, local-first browser for macOS.",
  "repository": {
    "type": "git",
    "url": "https://github.com/TechnifyScratch/localbrowser.git"
  },
  "main": "dist/main/index.js",
  "author": "Local",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 dist/main/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.main.json",
    "package": "npm run build && electron-builder --mac dmg zip --publish never",
    "package:arm64": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "package:x64": "npm run build && electron-builder --mac dmg zip --x64 --publish never",
    "package:universal": "npm run build && electron-builder --mac dmg zip --universal --publish never",
    "release:arm64": "npm run build && electron-builder --mac dmg zip --arm64 --publish always"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "electron-updater": "^6.8.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.local.browser",
    "productName": "Local",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/adblocker-engine.bin",
        "to": "adblocker-engine.bin"
      },
      {
        "from": "build/adblocker-NOTICE.txt",
        "to": "adblocker-NOTICE.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TechnifyScratch",
        "repo": "localbrowser",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "title": "Local",
      "backgroundColor": "#faf9f7",
      "iconSize": 112,
      "contents": [
        {
          "x": 150,
          "y": 185,
          "type": "file"
        },
        {
          "x": 430,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 580,
        "height": 380
      }
    }
  }
}
